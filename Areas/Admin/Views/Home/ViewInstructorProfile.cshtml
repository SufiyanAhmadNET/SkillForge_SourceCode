@model SkillForge.Areas.Instructor.Models.InstructorDashboardVM
@{
    ViewData["Title"] = "Instructor Profile Review";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.IsAdminView = true;
}

<main class="p-4 flex-grow-1 admin-bg">

    <!-- Back link + actions -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="page-title-bar">
            <div class="d-flex align-items-center gap-3">
                <h4 class="fw-bold mb-0">Instructor Profile Review</h4>
                @{
                    string statusClass = "bg-secondary";
                    string statusText = Model.ApplicationStatus.ToString();
                    if (Model.ApplicationStatus == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Approved) statusClass = "bg-success";
                    else if (Model.ApplicationStatus == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Pending) statusClass = "bg-warning text-dark";
                    else if (Model.ApplicationStatus == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Rejected) statusClass = "bg-danger";
                }
                <span class="badge @statusClass px-3 py-2 rounded-pill shadow-sm" style="font-size:12px; font-weight: 700;">
                    @statusText.Replace("Pending", "Pending Approval").Replace("NotApplied", "Not Applied")
                </span>
            </div>
            <span class="text-muted small">Viewing profile of @Model.FirstName @Model.LastName</span>
        </div>
        
        <div class="d-flex gap-2 align-items-center">
            @if (Model.ApplicationStatus == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Pending && Model.MentorApplicationId.HasValue)
            {
                <form asp-action="ApproveApplication" method="post" onsubmit="return confirm('Approve this instructor application?\n\nThis will grant them access to course creation tools.');" style="display:inline;">
                    <input type="hidden" name="id" value="@Model.MentorApplicationId" />
                    <button type="submit" class="btn btn-sm btn-success px-3 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i>Approve Application
                    </button>
                </form>
                <button type="button" class="btn btn-sm btn-outline-danger px-3 shadow-sm" onclick="openRejectModal(@Model.MentorApplicationId)">
                    <i class="bi bi-x-circle me-1"></i>Reject
                </button>
            }
            else if (Model.ApplicationStatus == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Approved && Model.MentorApplicationId.HasValue)
            {
                <form asp-action="RejectApplication" method="post" onsubmit="return confirm('Revoke this instructor\'s approval?\n\nThis will restrict their access and may affect visibility of their courses.');" style="display:inline;">
                    <input type="hidden" name="id" value="@Model.MentorApplicationId" />
                    <button type="submit" class="btn btn-sm btn-outline-danger px-3 shadow-sm">
                        <i class="bi bi-slash-circle me-1"></i>Revoke Approval
                    </button>
                </form>
            }

            <div class="vr mx-2 text-muted opacity-25" style="height: 24px;"></div>
            
            <a asp-action="Instructors" class="btn btn-sm btn-outline-secondary px-3">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">

        <!-- LEFT SIDE: Profile Summary -->
        <div class="col-lg-3">
            @await Html.PartialAsync("~/Views/Shared/InstructorProfile/_ProfileSummary.cshtml", Model)
        </div>

        <!-- RIGHT SIDE: Dynamic Sections -->
        <div class="col-lg-9">
            
            @await Html.PartialAsync("~/Views/Shared/InstructorProfile/_PersonalInfo.cshtml", Model)
            @await Html.PartialAsync("~/Views/Shared/InstructorProfile/_ProfessionalInfo.cshtml", Model)
            @await Html.PartialAsync("~/Views/Shared/InstructorProfile/_SocialInfo.cshtml", Model)
            @await Html.PartialAsync("~/Views/Shared/InstructorProfile/_ApplicationStatus.cshtml", Model)
            @await Html.PartialAsync("~/Views/Shared/InstructorProfile/_CourseSummary.cshtml", Model)

        </div>
    </div>
</main>

<!-- Reject Modal (Reusing existing rejection workflow) -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header bg-danger text-white border-0 py-3" style="border-top-left-radius: 15px; border-top-right-radius: 15px;">
                <h6 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Reject Application</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RejectApplication" method="post" onsubmit="return confirm('Reject this instructor application?\n\nThis will notify the instructor and they will need to reapply to proceed.');">
                <div class="modal-body p-4">
                    <input type="hidden" name="id" id="rejectAppId" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Reason for Rejection</label>
                        <textarea name="comment" class="form-control" rows="4" placeholder="Provide feedback to the instructor about why their application was rejected..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3" style="border-bottom-left-radius: 15px; border-bottom-right-radius: 15px;">
                    <button type="button" class="btn btn-sm btn-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger px-4 rounded-pill fw-bold shadow-sm">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    :root {
        --purple: #7c3aed;
        --purple-soft: rgba(124, 58, 237, 0.08);
    }

    /* Scoped refinements for Profile Page - Reused from Instructor Area */
    .form-section-title {
        font-size: .85rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        color: var(--purple);
        text-transform: uppercase;
        margin-bottom: 24px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--purple-soft);
    }

    .btn-section {
        border: 1px solid #f1f3f5;
        background: #fff;
        color: #555;
        text-align: left;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 10px;
        width: 100%;
        padding: 12px 16px !important;
    }

    .btn-section:hover {
        background: var(--purple-soft);
        color: var(--purple);
        border-color: var(--purple-soft);
    }

    .btn-section.active {
        background-color: var(--purple) !important;
        color: #fff !important;
        border-color: var(--purple) !important;
        box-shadow: 0 6px 15px rgba(124, 58, 237, 0.15);
    }

    .stat-mini {
        background: var(--purple-soft);
        transition: transform 0.2s;
    }
    .stat-mini:hover {
        transform: translateY(-2px);
    }

    .profile-content-section {
        display: none;
        animation: slideUpFade 0.4s ease-out;
    }
    .profile-content-section.active {
        display: block;
    }

    @@keyframes slideUpFade {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Form control polish */
    .form-control {
        border: 1px solid #e9ecef;
        border-radius: 8px;
        font-size: 0.9rem;
    }
    .form-label {
        color: #334155;
        margin-bottom: 0.4rem;
    }

    /* Admin specific adjustments to keep card consistent with Instructor area */
    .section-card {
        background: #fff;
        border-radius: 15px;
        border: 1px solid #f1f3f5;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const navBtns = document.querySelectorAll('.btn-section');
        const sections = document.querySelectorAll('.profile-content-section');

        navBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const targetId = this.getAttribute('data-section');
                
                // Update nav buttons
                navBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                // Update sections
                sections.forEach(s => s.classList.remove('active'));
                const targetSection = document.getElementById(targetId);
                if(targetSection) targetSection.classList.add('active');
            });
        });
    });

    function openRejectModal(id) {
        document.getElementById('rejectAppId').value = id;
        new bootstrap.Modal(document.getElementById('rejectModal')).show();
    }

    function toggleApplicationView(view) {
        const ctaView = document.getElementById('appCtaView');
        const formView = document.getElementById('appFormView');
        
        if (view === 'form') {
            if (ctaView) ctaView.style.display = 'none';
            if (formView) {
                formView.style.display = 'block';
                $(formView).hide().fadeIn(300);
            }
        } else {
            if (formView) formView.style.display = 'none';
            if (ctaView) {
                ctaView.style.display = 'block';
                $(ctaView).hide().fadeIn(300);
            }
        }
    }
</script>
