@model IEnumerable<SkillForge.Models.CertificateVM>

<div class="row g-3 mt-1">
    @if (Model != null && Model.Any())
    {
        @foreach (var cert in Model)
        {
            <div class="col-md-6">
                <div class="cert-card-full" onclick="location.href='@Url.Action("MyCertificates", "Home", new { area = "User" })'" style="cursor: pointer;">
                    <div class="cert-icon-lg"><i class="bi bi-patch-check-fill"></i></div>
                    <h6 class="fw-bold mb-1 text-truncate" title="@cert.CourseTitle">@cert.CourseTitle</h6>
                    <p class="text-muted small mb-1">Issued @cert.IssuedDate?.ToString("MMMM dd, yyyy")</p>
                    <p class="text-muted small mb-0">Certificate ID: <strong>@cert.CertificateNumber</strong></p>
                    <div class="cert-actions" onclick="event.stopPropagation();">
                        <a asp-area="User" asp-controller="Home" asp-action="ViewCertificate" asp-route-id="@cert.CourseId" target="_blank" class="btn-cert-action primary">
                            <i class="bi bi-eye"></i> View
                        </a>
                        <a href="javascript:void(0)" onclick="window.open('@Url.Action("ViewCertificate", "Home", new { area="User", id = cert.CourseId })', '_blank')" class="btn-cert-action">
                            <i class="bi bi-download"></i> PDF
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="text-center py-5 text-muted bg-white rounded-4 border border-dashed">
                <i class="bi bi-award mb-2 fs-2 opacity-25"></i>
                <p class="small mb-0">Complete a course to earn your first certificate!</p>
            </div>
        </div>
    }
</div>

<style>
    .cert-card-full {
        background: linear-gradient(135deg, #fffaf5 0%, #fff 60%);
        border: 1.5px solid rgba(255,122,0,.18);
        border-radius: 16px;
        padding: 20px;
        position: relative;
        overflow: hidden;
        transition: box-shadow .2s, transform .2s;
        height: 100%;
    }

    .cert-card-full:hover {
        box-shadow: 0 8px 28px rgba(255,122,0,.12);
        transform: translateY(-3px);
    }

    .cert-card-full::before {
        content: '';
        position: absolute;
        top: -30px;
        right: -30px;
        width: 80px;
        height: 80px;
        background: var(--orange-soft);
        border-radius: 50%;
        z-index: 0;
    }

    .cert-icon-lg {
        width: 48px;
        height: 48px;
        background: var(--orange-soft);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: var(--orange);
        margin-bottom: 12px;
        position: relative;
        z-index: 1;
    }

    .cert-card-full h6, .cert-card-full p, .cert-card-full .cert-actions {
        position: relative;
        z-index: 1;
    }

    .cert-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .btn-cert-action {
        font-size: .72rem;
        padding: 4px 10px;
        border-radius: 6px;
        border: 1.5px solid var(--border);
        background: #fff;
        color: var(--dark);
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: .2s;
    }

    .btn-cert-action:hover {
        border-color: var(--orange);
        color: var(--orange);
    }

    .btn-cert-action.primary {
        background: var(--orange);
        border-color: var(--orange);
        color: #fff;
    }

    .btn-cert-action.primary:hover {
        background: var(--orange-dark);
        color: #fff;
    }
</style>
