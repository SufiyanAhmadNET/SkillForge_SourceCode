@model CourseDetailsVM
@{
    Layout = "/Areas/User/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = Model.Title;
    var completedLessons = ViewBag.CompletedLessons as List<int> ?? new List<int>();
}

<div class="container-fluid py-3 px-lg-5 bg-light min-vh-100">
    
    <!-- TOP: Course Title & Basic Meta -->
    <div class="row mb-3">
        <div class="col-12">
            <!-- Navigation & Actions Row -->
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
                <a asp-action="EnrolledCourses" class="btn btn-sm btn-light border rounded-pill px-3 fw-medium shadow-sm" style="font-size: 0.75rem;">
                    <i class="bi bi-arrow-left me-1"></i> My Courses
                </a>

                <div id="certContainer" style="display: none;">
                    <a href="/User/Home/ViewCertificate/@Model.CourseId" target="_blank" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold shadow-sm" style="font-size: 0.75rem;">
                        Download Certificate
                    </a>
                </div>
            </div>

            <!-- Title -->
            <h4 class="fw-bold text-dark mb-0" style="letter-spacing: -0.01em;">@Model.Title</h4>
        </div>
    </div>

    <!-- MIDDLE: Learning Workspace (Video + Syllabus) -->
    <div class="row g-3 align-items-start">
        
        <!-- Video Player -->
        <div class="col-lg-8" oncontextmenu="return false;">
            <div class="card border-0 shadow-sm overflow-hidden rounded-3 bg-dark">
                <div id="videoWrapper" class="position-relative w-100 h-100">
                    <div id="videoContainer" class="ratio ratio-16x9 mx-auto" style="max-height: 480px; background-color: #000;">
                        <div class="d-flex flex-column align-items-center justify-content-center text-white h-100 bg-dark opacity-75">
                            <i class="bi bi-play-circle mb-2" style="font-size: 3.5rem; color: var(--orange);"></i>
                            <h6 class="fw-bold mb-1">Select a lesson to begin your journey</h6>
                            <p class="text-white-50" style="font-size: 0.75rem;">Your progress is automatically saved as you learn.</p>
                        </div>
                    </div>

                    <!-- Video Protection Elements (Hidden by default until video loads) -->
                    <div class="yt-protection-shield yt-shield-top d-none" title="Protected Content"></div>
                    <div class="yt-protection-shield yt-shield-logo d-none" title="Protected Content"></div>
                    
                    <!-- Dynamic Watermark -->
                    <div id="studentWatermark" class="video-watermark d-none">
                        @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                    </div>

                    <!-- Focus Loss Overlay -->
                    <div id="focusLossOverlay" class="focus-loss-overlay d-none flex-column align-items-center justify-content-center text-white text-center">
                        <i class="bi bi-pause-circle fs-1 mb-2"></i>
                        <h5 class="fw-bold mb-1">Playback Paused</h5>
                        <p class="small text-white-50 mb-0">Tab lost focus. Click here to resume.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Syllabus Sidebar -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 sticky-top learning-sidebar" style="top: 80px; max-height: 480px;">
                <div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between sticky-top top-0 z-3">
                    <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.95rem;">Course Content</h6>
                    <span class="badge bg-dark rounded-pill px-2 py-1" style="font-size: 0.6rem;">
                        @Model.modules?.SelectMany(m => m.Lessons).Count() Lessons
                    </span>
                </div>
                
                <div class="card-body p-0 overflow-auto" style="max-height: calc(480px - 58px);">
                    <div class="accordion accordion-flush" id="syllabusAccordion">
                        @if (Model.modules != null && Model.modules.Any())
                        {
                            @for (int i = 0; i < Model.modules.Count; i++)
                            {
                                var module = Model.modules[i];
                                <div class="accordion-item border-bottom border-light">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button @(i == 0 ? "" : "collapsed") shadow-none py-2 px-3" 
                                                type="button" 
                                                data-bs-toggle="collapse" 
                                                data-bs-target="#module-@module.Id">
                                            <div class="d-flex flex-column gap-0">
                                                <span class="fw-bold text-dark" style="font-size: 0.8rem;">Module @(i+1): @module.ModuleName</span>
                                                <span class="text-muted" style="font-size: 0.65rem;">@module.Lessons?.Count Lessons</span>
                                            </div>
                                        </button>
                                    </h2>
                                    <div id="module-@module.Id" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#syllabusAccordion">
                                        <div class="accordion-body p-0 bg-white">
                                            @if (module.Lessons != null && module.Lessons.Any())
                                            {
                                                @foreach (var lesson in module.Lessons.OrderBy(l => l.Order))
                                                {
                                                    var isCompleted = completedLessons.Contains(lesson.Id);
                                                    <div class="lp-lesson d-flex align-items-center gap-2 py-2 px-3 @(isCompleted ? "lp-lesson--done" : "")" 
                                                         onclick="loadVideo('@lesson.VideoUrl', @lesson.Id, this)">
                                                        
                                                        <div class="lp-lesson-icon flex-shrink-0">
                                                            @if (isCompleted)
                                                            {
                                                                <i class="bi bi-check-circle-fill text-success lesson-check-@lesson.Id" style="font-size: 0.9rem;"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-play-circle text-muted lesson-check-@lesson.Id" style="font-size: 0.9rem;"></i>
                                                            }
                                                        </div>

                                                        <div class="flex-grow-1 min-w-0">
                                                            <div class="lp-lesson-title text-truncate fw-medium" style="font-size: 0.78rem;">@lesson.Title</div>
                                                            <div class="d-flex align-items-center gap-1 mt-0">
                                                                <i class="bi bi-youtube text-danger" style="font-size: 0.65rem;"></i>
                                                                <span class="text-muted" style="font-size: 0.65rem;">YouTube</span>
                                                            </div>
                                                        </div>

                                                        <div class="flex-shrink-0 ms-1" onclick="event.stopPropagation();">
                                                            <input class="form-check-input lesson-checkbox rounded-1 border-secondary-subtle" 
                                                                   type="checkbox" 
                                                                   @(isCompleted ? "checked" : "")
                                                                   onchange="toggleCompletion(@lesson.Id, @Model.CourseId, event, this)"
                                                                   style="width: 1rem; height: 1rem; cursor: pointer;">
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="py-2 px-3 text-muted italic small" style="font-size: 0.7rem;">No lessons in this module.</div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 px-3 text-muted">
                                <i class="bi bi-journals d-block mb-1 fs-3 opacity-25"></i>
                                <p class="small mb-0" style="font-size: 0.75rem;">Course syllabus will be available soon.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BOTTOM: Progress & Tabs -->
    <div class="row g-3 mt-1">
        
        <div class="col-lg-8">
            <!-- Progress Section -->
            <div class="card border-0 shadow-sm p-2 px-3 mb-3 rounded-3">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <div class="flex-grow-1">
                        <div class="progress" style="height: 6px; background-color: #eee;">
                            <div id="courseProgressBar" class="progress-bar" role="progressbar" style="width: 0%; background-color: var(--orange);" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <span id="courseProgressText" class="fw-bold text-dark" style="min-width: 80px; font-size: 0.75rem;">0% Complete</span>
                </div>
            </div>

            <!-- Tabs & Info -->
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-body p-3 p-lg-4">
                    
                    <!-- Course Metadata (Relocated) -->
                    <div class="d-flex flex-wrap gap-3 text-muted align-items-center mb-3 pb-3 border-bottom" style="font-size: 0.78rem;">
                        <span class="badge rounded-pill px-3 py-1-5 fw-bold me-1" style="background: #fff3e6; color: var(--orange); border: 1px solid #ffe5d4; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;">
                            @Model.CategoryName
                        </span>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-collection-play text-orange"></i>
                            <span class="fw-semibold">@Model.modules?.Count Modules</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-bar-chart-steps text-orange"></i>
                            <span class="fw-semibold">@Model.Difficulty</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history text-orange"></i>
                            <span class="fw-semibold">1 Year Access</span>
                        </div>
                    </div>

                    <!-- Tabs -->
                    <ul class="nav nav-pills custom-pills mb-3 gap-1" id="courseTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold px-3 py-1-5" style="font-size: 0.85rem;" data-bs-toggle="tab" data-bs-target="#description" type="button">About Course</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold px-3 py-1-5" style="font-size: 0.85rem;" data-bs-toggle="tab" data-bs-target="#outcomes" type="button">What You'll Learn</button>
                        </li>
                    </ul>

                    <div class="tab-content" id="courseTabContent">
                        <div class="tab-pane fade show active" id="description" role="tabpanel">
                            <div class="lh-base text-dark" style="font-size: 0.9rem; white-space: pre-line;">
                                @Model.Desciption
                            </div>
                        </div>
                        <div class="tab-pane fade" id="outcomes" role="tabpanel">
                            @if (Model.outcomes != null && Model.outcomes.Any())
                            {
                                <div class="row g-2">
                                    @foreach (var outcome in Model.outcomes)
                                    {
                                        <div class="col-md-6">
                                            <div class="d-flex align-items-start gap-2 p-2 rounded-2 bg-light border border-white h-100 shadow-sm">
                                                <i class="bi bi-check2-circle text-success" style="font-size: 1rem;"></i>
                                                <span class="fw-medium text-dark mt-0-5" style="font-size: 0.8rem;">@outcome.Outcome</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-3 text-muted small bg-light rounded-3 border border-dashed">
                                    <i class="bi bi-info-circle me-1"></i> No specific learning outcomes listed.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    // load youtube video in player
    function loadVideo(url, lessonId, element) {
        if (!url) { showAlert("No video for this lesson.", "info"); return; }

        let videoId = '';
        if (url.includes('youtube.com/watch?v='))    videoId = url.split('v=')[1].split('&')[0];
        else if (url.includes('youtu.be/'))          videoId = url.split('youtu.be/')[1].split('?')[0];
        else if (url.includes('embed/'))             videoId = url.split('embed/')[1].split('?')[0];

        const container = document.getElementById('videoContainer');
        if (videoId) {
            container.innerHTML = `<iframe id="ytIframe" src="https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&disablekb=1&enablejsapi=1"
                frameborder="0" style="width:100%; height:100%;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
            
            // Show protection elements
            document.querySelectorAll('.yt-protection-shield').forEach(el => el.classList.remove('d-none'));
            document.getElementById('studentWatermark').classList.remove('d-none');
        } else {
            container.innerHTML = `<div class='p-5 h-100 d-flex align-items-center justify-content-center text-center text-white bg-dark'>
                <div><i class="bi bi-exclamation-triangle mb-2 d-block fs-2 text-warning"></i>Invalid or missing YouTube video link</div>
            </div>`;
            
            // Hide protection elements
            document.querySelectorAll('.yt-protection-shield').forEach(el => el.classList.add('d-none'));
            document.getElementById('studentWatermark').classList.add('d-none');
        }

        // highlight active lesson
        document.querySelectorAll('.lp-lesson').forEach(el => el.classList.remove('lp-lesson--active'));
        element.classList.add('lp-lesson--active');
    }

    // mark lesson complete via ajax — backend untouched
    function toggleCompletion(lessonId, courseId, event, checkbox) {
        event.stopPropagation();
        $.ajax({
            url: '/User/Home/MarkLessonComplete',
            type: 'POST',
            data: { lessonId, courseId },
            success: function (res) {
                if (res.success) {
                    const icon = document.querySelector(`.lesson-check-${lessonId}`);
                    icon.className = checkbox.checked
                        ? `bi bi-check-circle-fill text-success lesson-check-${lessonId}`
                        : `bi bi-play-circle text-muted lesson-check-${lessonId}`;

                    // toggle done state on row
                    const row = checkbox.closest('.lp-lesson');
                    row.classList.toggle('lp-lesson--done', checkbox.checked);

                    // update progress bar
                    const progress = parseInt(res.progress);
                    const progressBar = document.getElementById('courseProgressBar');
                    progressBar.style.width = progress + '%';
                    progressBar.setAttribute('aria-valuenow', progress);
                    document.getElementById('courseProgressText').innerText = progress + '% Complete';

                    // Certificate button visibility
                    const certBtn = document.getElementById('certContainer');
                    if (progress === 100) {
                        certBtn.style.display = 'block';
                        if (checkbox.checked) {
                            showAlert(`🎉 Congratulations! You have completed the course. <a href="/User/Home/ViewCertificate/${courseId}" target="_blank" class="fw-bold text-white border-bottom border-white pb-0">Download Certificate</a>`, "success", 10000);
                        }
                    } else {
                        certBtn.style.display = 'none';
                    }
                }
            },
            error: function() {
                checkbox.checked = !checkbox.checked; // revert if failed
                showAlert("Could not update progress. Please try again.", "danger");
            }
        });
    }

    // init progress on load
    $(document).ready(function () {
        const total     = @(Model.modules?.SelectMany(m => m.Lessons).Count() ?? 0);
        const completed = @completedLessons.Count;
        const pct       = total > 0 ? Math.round((completed / total) * 100) : 0;

        const progressBar = document.getElementById('courseProgressBar');
        if(progressBar) {
            progressBar.style.width = pct + '%';
            progressBar.setAttribute('aria-valuenow', pct);
        }
        const progressText = document.getElementById('courseProgressText');
        if(progressText) progressText.innerText  = pct + '% Complete';

        // Initial certificate button state
        const certBtn = document.getElementById('certContainer');
        if (pct === 100) {
            certBtn.style.display = 'block';
        }

        // Anti-Piracy: Focus Loss Protection
        document.addEventListener('visibilitychange', function() {
            const overlay = document.getElementById('focusLossOverlay');
            const iframe = document.getElementById('ytIframe');
            
            if (document.hidden) {
                if (iframe && iframe.contentWindow) {
                    iframe.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
                }
                if (overlay) {
                    overlay.classList.remove('d-none');
                    overlay.classList.add('d-flex');
                }
            }
        });

        // Resume on click
        document.getElementById('focusLossOverlay')?.addEventListener('click', function() {
            this.classList.remove('d-flex');
            this.classList.add('d-none');
        });

        // Anti-Piracy: Shortcut Deterrence
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey && (e.key === 's' || e.key === 'S' || e.key === 'p' || e.key === 'P')) ||
                e.key === 'PrintScreen' ||
                (e.metaKey && e.shiftKey && (e.key === '3' || e.key === '4'))) {
                e.preventDefault();
                showAlert("Action blocked. Screen recording and printing are not permitted for protected content.", "warning");
            }
        });
    });
</script>
}

<style>
    :root {
        --text-orange: var(--orange);
    }

    .text-orange { color: var(--orange); }

    .py-1-5 { padding-top: 0.35rem; padding-bottom: 0.35rem; }
    .mt-0-5 { margin-top: 0.125rem; }

    /* Custom nav pills */
    .custom-pills .nav-link {
        color: #666;
        border-radius: 6px;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }
    .custom-pills .nav-link:hover {
        color: var(--orange);
        background-color: #fff3e6;
    }
    .custom-pills .nav-link.active {
        background-color: var(--orange) !important;
        color: white !important;
        box-shadow: 0 2px 6px rgba(255, 107, 0, 0.15);
    }

    /* Lesson row styling */
    .lp-lesson {
        cursor: pointer;
        border-left: 3px solid transparent;
        transition: all 0.2s ease;
    }
    .lp-lesson:hover {
        background-color: #f8f9fa;
    }
    .lp-lesson--active {
        background-color: #fff3e6 !important;
        border-left-color: var(--orange) !important;
    }
    .lp-lesson--done {
        background-color: #f0fff4;
    }
    .lp-lesson--done .lp-lesson-title {
        color: #28a745;
    }

    /* Accordion Customization */
    .accordion-button:not(.collapsed) {
        background-color: #fffaf5;
        color: var(--orange);
    }
    .accordion-button::after {
        background-size: 0.7rem;
    }

    /* Sticky Sidebar Scrollbar */
    .learning-sidebar .card-body::-webkit-scrollbar {
        width: 4px;
    }
    .learning-sidebar .card-body::-webkit-scrollbar-track {
        background: #f1f1f1;
    }
    .learning-sidebar .card-body::-webkit-scrollbar-thumb {
        background: #ddd;
        border-radius: 10px;
    }
    .learning-sidebar .card-body::-webkit-scrollbar-thumb:hover {
        background: #ccc;
    }

    /* Responsiveness tweaks */
    @@media (max-width: 991.98px) {
        .learning-sidebar {
            position: static !important;
            max-height: 500px !important;
            margin-top: 1rem;
        }
    }

    /* Anti-Piracy Protection Layer */
    .yt-protection-shield {
        position: absolute;
        z-index: 10;
        cursor: default;
        background: transparent;
    }
    .yt-shield-top {
        top: 0; left: 0; right: 0; height: 75px; /* Increased height to ensure title and share are covered */
    }
    .yt-shield-logo {
        bottom: 0; right: 0; width: 120px; height: 50px;
    }

    /* Dynamic Watermark */
    .video-watermark {
        position: absolute;
        z-index: 20;
        top: 10%;
        left: 5%;
        color: rgba(255, 255, 255, 0.25); /* Slightly more visible since it doesn't move */
        font-size: 0.9rem;
        font-weight: bold;
        pointer-events: none; /* Let clicks pass through */
        text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
    }

    /* Focus Loss Overlay */
    .focus-loss-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.85);
        z-index: 30;
        cursor: pointer;
        backdrop-filter: blur(4px);
    }

    /* Selection deterrence */
    body {
        user-select: none;
        -webkit-user-select: none;
    }
    input, textarea, select {
        user-select: auto;
        -webkit-user-select: auto;
    }
    </style>
