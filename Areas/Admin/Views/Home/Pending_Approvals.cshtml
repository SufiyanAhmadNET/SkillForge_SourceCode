@model PendingApprovalsVM
@{
    ViewData["Title"] = "Pending Approvals";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<main class="p-3 flex-grow-1 admin-bg">

    <!-- Page title -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="page-title-bar">
            <h5 class="fw-bold mb-0">Pending Approvals</h5>
            <p class="text-muted mb-0" style="font-size:13px;">Review and manage pending platform requests.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary-subtle px-3 py-2" style="font-size: 12px;">
                <i class="bi bi-people me-1"></i> @Model.PendingApplicationsCount Instructor Applications
            </span>
            <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2" style="font-size: 12px;">
                <i class="bi bi-journal-check me-1"></i> @Model.PendingCoursesCount Course Approvals
            </span>
        </div>
    </div>

    <!-- TOP SUMMARY ROW -->
    <div class="row g-3 mb-4">
        <!-- Recent Instructor Requests -->
        <div class="col-lg-6">
            <div class="card border-0 admin-card h-100">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold small"><i class="bi bi-person-plus me-2 text-primary"></i>Instructor Requests</h6>
                    <span class="text-muted small" style="font-size: 11px;">Latest</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var app in Model.Applications.Where(a => a.Status == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Pending).Take(3))
                        {
                            <div class="list-group-item py-2 px-3 border-0 border-bottom">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="tbl-avatar bg-primary bg-opacity-10 text-primary fw-bold" style="width: 24px; height: 24px; font-size: 10px;">
                                            @app.InstructorName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-medium text-dark small">@app.InstructorName</div>
                                            <div class="text-muted" style="font-size: 10px;">@app.Expertise · @app.Experience yrs exp.</div>
                                        </div>
                                    </div>
                                    <span class="text-muted" style="font-size: 10px;">@app.AppliedDate.ToString("MMM dd")</span>
                                </div>
                                <div class="d-flex gap-1 mt-2 justify-content-end">
                                    <a asp-action="ViewInstructorProfile" asp-route-id="@app.InstructorId" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;">Profile</a>
                                    <form asp-action="ApproveApplication" method="post" onsubmit="return confirm('Approve this instructor application?\n\nThis will grant them access to course creation tools.');" style="display:inline;">
                                        <input type="hidden" name="id" value="@app.Id" />
                                        <button type="submit" class="btn btn-sm btn-success py-0 px-2" style="font-size: 11px;">Approve</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 11px;" onclick="openRejectModal(@app.Id)">Reject</button>
                                </div>
                            </div>
                        }
                        @if (!Model.Applications.Any(a => a.Status == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Pending))
                        {
                            <div class="py-4 text-center text-muted small">No pending instructors</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Course Requests -->
        <div class="col-lg-6">
            <div class="card border-0 admin-card h-100">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold small"><i class="bi bi-journal-plus me-2 text-success"></i>Recent Course Requests</h6>
                    <span class="text-muted small" style="font-size: 11px;">Top 3 Latest</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var course in Model.Courses.Where(c => c.Status == SkillForge.Services.Courses.Models.CourseStatus.PendingReview).Take(3))
                        {
                            <div class="list-group-item py-2 px-3 border-0 border-bottom">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="tbl-avatar bg-success bg-opacity-10 text-success" style="width: 24px; height: 24px;">
                                            <i class="bi bi-book small"></i>
                                        </div>
                                        <div>
                                            <div class="fw-medium text-dark small text-truncate" style="max-width: 200px;">@course.Title</div>
                                            <div class="text-muted" style="font-size: 10px;">by @course.InstructorName · @course.Category</div>
                                        </div>
                                    </div>
                                    <span class="text-muted" style="font-size: 10px;">@course.SubmittedDate.ToString("MMM dd")</span>
                                </div>
                                <div class="d-flex gap-1 mt-2 justify-content-end align-items-center">
                                    <a href="/User/Home/CourseDetails?id=@course.Id&preview=true" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;">View</a>
                                    <form asp-action="ApproveCourse" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@course.Id" />
                                        <button type="submit" class="btn btn-sm btn-success py-0 px-2" style="font-size: 11px;">Approve</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 11px;" onclick="openCourseRejectModal(@course.Id)">Reject</button>
                                </div>
                            </div>
                        }
                        @if (!Model.Courses.Any(c => c.Status == SkillForge.Services.Courses.Models.CourseStatus.PendingReview))
                        {
                            <div class="py-4 text-center text-muted small">No pending courses</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- INSTRUCTOR APPLICATIONS TABLE -->
    <div class="card border-0 admin-card mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
            <h6 class="mb-0 fw-bold small"><i class="bi bi-person-check me-2 text-primary"></i>Instructor Applications</h6>
            <ul class="nav nav-pills nav-sm" style="font-size:11px;" id="applicationFilters">
                <li class="nav-item"><a class="nav-link py-1 px-3 active" href="#" data-filter="all">All</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-3" href="#" data-filter="Pending">Pending</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-3" href="#" data-filter="Approved">Approved</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-3" href="#" data-filter="Rejected">Rejected</a></li>
            </ul>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 13px;">
                    <thead class="table-light text-muted" style="font-size: 11px; letter-spacing: 0.02rem;">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>Instructor</th>
                            <th>Email</th>
                            <th>Specialisation</th>
                            <th>Applied</th>
                            <th>Status</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="applicationTableBody">
                        @{
                            int appIndex = ((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1;
                        }
                        @foreach (var app in Model.Applications)
                        {
                            <tr data-status="@app.Status">
                                <td class="ps-3 text-muted">@(appIndex++.ToString("D2"))</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="tbl-avatar bg-primary bg-opacity-10 text-primary fw-bold" style="width: 26px; height: 26px; font-size: 10px;">
                                            @(string.IsNullOrEmpty(app.InstructorName) ? "?" : app.InstructorName.Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="fw-medium text-dark">@app.InstructorName</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@app.Email</td>
                                <td class="fw-medium">@app.Expertise</td>
                                <td><span class="text-muted small">@app.AppliedDate.ToString("MMM dd, yyyy")</span></td>
                                <td>
                                    @if (app.Status == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Pending)
                                    {
                                        <span class="status-pending">Pending</span>
                                    }
                                    else if (app.Status == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Approved)
                                    {
                                        <span class="status-approved">Approved</span>
                                    }
                                    else if (app.Status == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Rejected)
                                    {
                                        <span class="status-rejected">Rejected</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="ViewInstructorProfile" asp-route-id="@app.InstructorId" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;">Profile</a>
                                        @if (app.Status == SkillForge.Services.Instructors.Models.MentorApplicationStatus.Pending)
                                        {
                                            <form asp-action="ApproveApplication" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <button type="submit" class="btn btn-sm btn-success py-0 px-2" style="font-size: 11px;">Approve</button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 11px;" onclick="openRejectModal(@app.Id)">Reject</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <small class="text-muted">Instructor applications are paged</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Pending_Approvals" asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Pending_Approvals" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages || ViewBag.TotalPages == 0 ? "disabled" : "")">
                        <a class="page-link" asp-action="Pending_Approvals" asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- COURSE APPROVALS TABLE -->
    <div class="card border-0 admin-card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
            <h6 class="mb-0 fw-bold small"><i class="bi bi-journal-check me-2 text-success"></i>Course Approvals</h6>
            <ul class="nav nav-pills nav-sm" style="font-size:11px;" id="courseFilters">
                <li class="nav-item"><a class="nav-link py-1 px-3 active" href="#" data-filter="all">All Courses</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-3" href="#" data-filter="PendingReview">Pending Review</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-3" href="#" data-filter="Approved">Approved</a></li>
            </ul>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 13px;">
                    <thead class="table-light text-muted" style="font-size: 11px; letter-spacing: 0.02rem;">
                        <tr>
                            <th class="ps-3">Course</th>
                            <th>Instructor</th>
                            <th>Category</th>
                            <th>Modules</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="courseTableBody">
                        @foreach (var course in Model.Courses)
                        {
                            <tr data-status="@course.Status">
                                <td class="ps-3">
                                    <div class="fw-medium text-dark">@course.Title</div>
                                    <div class="text-muted" style="font-size: 11px;">₹@course.Price · @course.DurationWeeks wks</div>
                                </td>
                                <td class="fw-medium">@course.InstructorName</td>
                                <td class="text-muted small">@course.Category</td>
                                <td class="text-muted small">@course.ModuleCount Modules / @course.LessonCount Lessons</td>
                                <td><span class="text-muted small">@course.SubmittedDate.ToString("MMM dd, yyyy")</span></td>
                                <td>
                                    @if (course.Status == SkillForge.Services.Courses.Models.CourseStatus.PendingReview)
                                    {
                                        <span class="status-pending">Pending Review</span>
                                    }
                                    else if (course.Status == SkillForge.Services.Courses.Models.CourseStatus.Approved || course.Status == SkillForge.Services.Courses.Models.CourseStatus.Published)
                                    {
                                        <span class="status-approved">Approved</span>
                                    }
                                    else if (course.Status == SkillForge.Services.Courses.Models.CourseStatus.Rejected)
                                    {
                                        <span class="status-rejected">Rejected</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a href="/User/Home/CourseDetails?id=@course.Id&preview=true" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;">Preview</a>
                                        @if (course.Status == SkillForge.Services.Courses.Models.CourseStatus.PendingReview)
                                        {
                                            <form asp-action="ApproveCourse" method="post" onsubmit="return confirm('Approve this course submission?\n\nThis will make the course live on the platform for students to enroll.');" style="display:inline;">
                                                <input type="hidden" name="id" value="@course.Id" />
                                                <button type="submit" class="btn btn-sm btn-success py-0 px-2" style="font-size: 11px;">Approve</button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 11px;" onclick="openCourseRejectModal(@course.Id)">Reject</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Courses.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No courses found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</main>

<!-- Reject Modal (Application) -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header bg-danger text-white">
                <h6 class="modal-title fw-bold small">Reject Instructor Application</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RejectApplication" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="rejectAppId" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Reason for Rejection</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Explain why the application was rejected..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger px-4">Confirm Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Course Reject Modal -->
<div class="modal fade" id="courseRejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header bg-danger text-white">
                <h6 class="modal-title fw-bold small">Reject Course Submission</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RejectCourse" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="rejectCourseId" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Feedback for Instructor</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Explain what needs to be improved..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger px-4">Confirm Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openRejectModal(id) {
        document.getElementById('rejectAppId').value = id;
        new bootstrap.Modal(document.getElementById('rejectModal')).show();
    }

    function openCourseRejectModal(id) {
        document.getElementById('rejectCourseId').value = id;
        new bootstrap.Modal(document.getElementById('courseRejectModal')).show();
    }

    // Tab Filters logic
    function setupFilter(filterId, tableBodyId) {
        document.querySelectorAll(`#${filterId} .nav-link`).forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                document.querySelectorAll(`#${filterId} .nav-link`).forEach(l => l.classList.remove('active'));
                this.classList.add('active');
                
                const filter = this.getAttribute('data-filter');
                const rows = document.querySelectorAll(`#${tableBodyId} tr`);
                
                rows.forEach(row => {
                    if (filter === 'all' || row.getAttribute('data-status') === filter) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });
    }

    setupFilter('applicationFilters', 'applicationTableBody');
    setupFilter('courseFilters', 'courseTableBody');
</script>