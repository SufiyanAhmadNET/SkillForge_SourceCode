@model IEnumerable<SkillForge.Models.CertificateVM>
@{
    Layout = "/Areas/User/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "My Certificates";
    var earned = Model.Where(c => c.IsEarned).ToList();
    var locked = Model.Where(c => !c.IsEarned).ToList();
}

<partial name="_PageTitleBanner" />

<div class="mb-4">
    <span class="text-muted small">@earned.Count earned · @locked.Count in progress</span>
</div>

<!-- EARNED -->
<div class="section-card mb-4">
    <div class="section-card-title">Earned Certificates</div>
    <partial name="_EarnedCertificatesPartial" model="earned" />
</div>

<!-- IN PROGRESS — locked certs -->
<div class="section-card">
    <div class="section-card-title">Complete to Unlock</div>
    <div class="row g-3">
        @if (locked.Any())
        {
            @foreach (var cert in locked)
            {
                <div class="col-md-4">
                    <div class="cert-card-locked">
                        <div class="cert-icon-lg"><i class="bi bi-lock"></i></div>
                        <h6 class="fw-bold mb-1 small text-truncate" title="@cert.CourseTitle">@cert.CourseTitle</h6>
                        <p class="text-muted small mb-2">@cert.ProgressPercentage% complete</p>
                        <div class="progress" style="height: 6px;"><div class="progress-bar" style="width:@cert.ProgressPercentage%; background-color: var(--orange);"></div></div>
                        <a asp-action="LearningView" asp-route-id="@cert.CourseId" class="btn-resume mt-3 d-inline-block" style="font-size:.78rem;padding:5px 12px">
                            <i class="bi bi-play-fill me-1"></i>Continue
                        </a>
                    </div>
                </div>
            }
        }
        else if (!earned.Any())
        {
            <div class="col-12">
                <div class="text-center py-5 text-muted bg-white rounded-4 border border-dashed">
                    <i class="bi bi-book mb-2 fs-2 opacity-25"></i>
                    <p class="small mb-0">No active courses. <a asp-action="Courses" class="text-orange text-decoration-none fw-bold">Browse Courses</a></p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* locked cert — courses not yet completed */
    .cert-card-locked {
        background: #fcfcfc;
        border: 1.5px dashed #e0e0e0;
        border-radius: 16px;
        padding: 24px;
    }

    .cert-card-locked .cert-icon-lg {
        background: #f1f1f1;
        color: #ccc;
    }

    .btn-resume {
        background: #fff;
        border: 1.5px solid var(--orange);
        color: var(--orange);
        font-weight: 600;
        border-radius: 8px;
        text-decoration: none;
        transition: .2s;
    }
    .btn-resume:hover {
        background: var(--orange);
        color: #fff;
    }
</style>
